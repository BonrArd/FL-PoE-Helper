	Class == "Claws" "Daggers" "Wands" "One Hand Swords" "Thrusting One Hand Swords" "One Hand Axes" "One Hand Maces" "Sceptres" "Rune Daggers" "Staves" "Warstaves" "Two Hand Swords" "Two Hand Axes" "Two Hand Maces" "Fishing Rods" "Bows" "Quivers"
	Rarity <= Rare
	LinkedSockets < 5

