	PlayEffect Yellow
	MinimapIcon 1 Red Square

Show # Mapas T6-10
	Class == "Maps"
	MapTier >= 6
	SetFontSize 45
	SetTextColor 255 255 255 255
	SetBackgroundColor 20 20 0 255
	PlayAlertSound 4 300
	PlayEffect White
	MinimapIcon 1 Yellow Square

Show # Mapas T1-5
	Class == "Maps"
	SetFontSize 45
	SetTextColor 255 255 255 255
	SetBackgroundColor 20 20 0 255
	PlayAlertSound 4 300
	PlayEffect White
	MinimapIcon 2 White Square

#==============================================================================
# 6. GEMAS
#==============================================================================

Show # Gemas especiais (corrompidas 21/23, transfiguradas de qualidade)
	Class == "Skill Gems" "Support Gems"
	GemLevel >= 21
	SetFontSize 45
	SetTextColor 20 240 240 255
	SetBorderColor 240 0 0 255
	SetBackgroundColor 70 0 20 255
	PlayAlertSound 1 300
	PlayEffect Red
	MinimapIcon 0 Red Triangle

Show # Gemas com qualidade
	Class == "Skill Gems" "Support Gems"
	Quality >= 1
	SetFontSize 45
	SetTextColor 20 240 240 255
	SetBorderColor 20 240 240 255
	SetBackgroundColor 6 0 60 255
	PlayAlertSound 2 300
	PlayEffect White
	MinimapIcon 1 Yellow Triangle

Show # Gemas (campanha)
	Class == "Skill Gems" "Support Gems"
	AreaLevel < 68
	SetFontSize 40
	SetBorderColor 0 0 0

Show # Gemas (mapas)
	Class == "Skill Gems" "Support Gems"
	SetFontSize 30
	SetTextColor 40 130 130 255
	SetBorderColor 0 0 0

#==============================================================================
# 7. LINKS E SOCKETS
#==============================================================================

Show # 5-link na campanha (5L grátis do guia: Slave Pens / Twilight Strand A6)
	LinkedSockets 5
	AreaLevel < 68
	SetFontSize 45
	SetTextColor 0 240 190 255
	SetBorderColor 0 240 190 255
	SetBackgroundColor 20 20 0 255
	PlayAlertSound 3 300
	PlayEffect Yellow
	MinimapIcon 1 Yellow Diamond

Show # 5-link
	LinkedSockets 5
	SetFontSize 45
	SetBorderColor 0 240 190 255
	PlayAlertSound 3 300
	PlayEffect Blue
	MinimapIcon 2 Blue Diamond

Show # 6 sockets (Jeweller's)
	Sockets 6
	SetFontSize 45
	SetTextColor 255 255 255 255
	SetBorderColor 255 255 255 255
	SetBackgroundColor 155 138 138 255
	PlayAlertSound 2 300
	PlayEffect Grey
	MinimapIcon 2 Grey Hexagon

Show # BUILD: 4-link com 3+ verdes (PConc é verde)
	SocketGroup >= 4GGG
	AreaLevel < 68
	SetFontSize 45
	SetTextColor 0 240 190 255
	SetBorderColor 0 255 0 255
	SetBackgroundColor 0 60 20 255
	PlayAlertSound 3 300
	PlayEffect Green
	MinimapIcon 1 Green Diamond

Show # 4-link (campanha)
	LinkedSockets 4
	AreaLevel < 68
	SetFontSize 45
	SetBorderColor 0 140 240 255
	SetBackgroundColor 20 20 0 255
	PlayEffect Grey
	MinimapIcon 2 Grey Diamond

Show # 3-link verde (Atos 1-3)
	SocketGroup >= 3GG
	AreaLevel < 33
	SetFontSize 40
	SetBorderColor 0 120 120 255
	SetBackgroundColor 20 20 0 255
	PlayEffect Grey Temp

Show # 3-link (Ato 1)
	LinkedSockets 3
	AreaLevel <= 13
	SetFontSize 40
	SetBorderColor 0 120 120 255
	SetBackgroundColor 20 20 0 255
	PlayEffect Grey Temp

Show # RGB pequeno (Chromatic Orb, até Ato 5)
	SocketGroup RGB
	Class == "Body Armours" "Helmets" "Gloves" "Boots" "Shields"
	Width <= 2
	Height <= 2
	AreaLevel < 45
	SetFontSize 45
	SetTextColor 255 255 255 255
	SetBorderColor 255 255 255 255
	SetBackgroundColor 155 138 138 255
	PlayAlertSound 2 300
	PlayEffect Grey
	MinimapIcon 2 Grey Hexagon

